# id del servidor creado en el panel (POST /admin/api/servers)
SERVER_ID=1
# URL interna del panel (la que el nodo usa para pedir su configuración)
PANEL_URL=http://panel.tudominio.com
# Iguales que en el panel
AGENT_KEY=cambia-esto
STREAM_SECRET=cambia-esto
# Redis del servidor principal
REDIS_URL=redis://:contraseña@IP_DEL_PRINCIPAL:6379
# Carpeta con las películas y series (p. ej. montaje rclone)
MEDIA_DIR=/mnt/media
# Segundos sin espectadores antes de parar un canal bajo demanda
IDLE_TIMEOUT=60
HTTP_PORT=8081
